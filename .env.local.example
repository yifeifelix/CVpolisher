# CV Polisher - Environment Configuration
# Copy this file to .env.local and fill in your credentials.

# ==============================================================
# NextAuth v5 (Phase 1 auth — see ADR-0004 §6)
# ==============================================================

# Required in all environments. At least 32 characters of random.
# Generate with:   npm exec auth secret
# or:              openssl rand -base64 33
AUTH_SECRET=replace-with-32-plus-char-random-string

# Set to 'true' when running behind a reverse proxy (Caddy, nginx,
# Cloudflare Tunnel). Leave unset for local `npm run dev`.
# AUTH_TRUST_HOST=true

# Google OAuth (Phase 1 placeholder — real credentials land in
# Phase 4 launch checklist). Leave blank in development; the
# credentials-provider login path works without them. Clicking
# "Sign in with Google" will fail until these are populated.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ==============================================================
# LLM providers (at least ONE must be configured)
# ==============================================================

# --- OpenRouter ---
# Note: If your system already has OPENROUTER_API_KEY set (e.g. from Claude Code),
# use CV_OPENROUTER_API_KEY to override it for this project.
CV_OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODELS=anthropic/claude-sonnet-4,anthropic/claude-haiku-4.5,anthropic/claude-opus-4

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
BEDROCK_MODELS=anthropic.claude-sonnet-4-20250514-v1:0,anthropic.claude-haiku-4-5-20251001-v1:0

# --- Google Vertex AI ---
# Point to your service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_REGION=us-central1
GOOGLE_MODELS=claude-sonnet-4@20250514,claude-haiku-4-5@20251001

# ==============================================================
# Server
# ==============================================================
PORT=3443
HOST=0.0.0.0
